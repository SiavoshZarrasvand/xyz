// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Contact {
  id            String    @id @default(uuid())
  name          String
  phone         String?   @unique
  email         String?
  website       String?
  address       String?
  category      String?
  tag           String?
  rating        Float?
  reviews       Int?
  googleMapsUrl String?
  inviteCode    String?   @unique
  contacted     Boolean   @default(false)
  contactedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([contacted])
  @@index([phone])
  @@index([tag])
}

model InCosmeticsExhibitor {
  id          String    @id @default(uuid())
  name        String
  stand       String?
  whyVisit    String?
  description String?
  website     String?
  email       String?
  phone       String?
  street      String?
  city        String?
  postcode    String?
  country     String?
  address     String?
  url         String?   @unique
  contacted   Boolean   @default(false)
  contactedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([contacted])
  @@index([country])
  @@index([stand])
}

model AllaBolagCompany {
  id            String    @id @default(uuid())
  name          String
  orgnr         String?
  phone         String?
  email         String?
  website       String?
  googleMapsUrl String?
  street        String?
  postcode      String?
  city          String?
  address       String?
  url           String?   @unique
  contacted     Boolean   @default(false)
  contactedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([contacted])
  @@index([orgnr])
  @@index([city])
  @@index([website])
}

model KiteBeachSupplier {
  id            String    @id @default(uuid())
  name          String
  beach         String?
  destination   String?
  spot          String?
  city          String?
  state         String?   @default("CE")
  country       String?   @default("Brazil")
  category      String?
  phone         String?
  email         String?
  website       String?
  instagram     String?
  address       String?
  rating        Float?
  reviews       Int?
  googleMapsUrl String?
  hours         String?
  tag           String?
  notes         String?
  contacted     Boolean   @default(false)
  contactedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([contacted])
  @@index([beach])
  @@index([destination])
  @@index([spot])
  @@index([country])
  @@index([phone])
  @@index([category])
  @@index([tag])
}

